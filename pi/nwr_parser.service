[Unit]
Description=NOAA Weather Radio SAME decoder and MQTT publisher
Documentation=https://github.com/swise01/HA-NWR-SDR
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
EnvironmentFile=/opt/nwr/config.env
Environment=NWR_CONFIG=/opt/nwr/config.env
ExecStartPre=/bin/sleep 3
ExecStartPre=-/usr/bin/pkill -9 -x rtl_fm
ExecStartPre=-/usr/bin/pkill -9 -x multimon-ng
ExecStart=/opt/nwr_venv/bin/python3 /opt/nwr/nwr_parser.py
Restart=always
RestartSec=10
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nwr

[Install]
WantedBy=multi-user.target
