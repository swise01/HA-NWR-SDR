MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=mqtt
MQTT_PASS=change-me
MQTT_TOPIC_ROOT=nwr
MQTT_CLIENT_ID=nwr_same_parser
MQTT_TLS=false
# MQTT_CA_CERT=/etc/ssl/certs/ca-certificates.crt

SDR_FREQUENCY=162.550M
SDR_DEVICE_INDEX=0
SDR_SAMPLE_RATE=32000
SAME_SAMPLE_RATE=22050
SDR_GAIN=49.6
SDR_PPM=0
SDR_DEEMPHASIS=true
SDR_DC_BLOCK=true
SDR_FIR=true

# Comma-separated SAME/FIPS county codes. Leave empty to pass every decoded alert.
# Format: 0 + state FIPS + county FIPS. Example: Jefferson County, AL = 001073.
FIPS_FILTER=

AUDIO_STREAM_PORT=8765
# Set one of these when automatic LAN address discovery is not suitable.
# AUDIO_ADVERTISE_HOST=nwr-radio.example.lan
# AUDIO_STREAM_URL=https://example.lan/nwr.mp3
LOG_LEVEL=INFO
# Leave blank to use the systemd journal only.
LOG_FILE=

# Space-separated topics for the optional MQTT audit service.
MQTT_AUDIT_TOPICS=nwr/#
