MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=mqtt
MQTT_PASS=change-me
MQTT_TOPIC_ROOT=nwr

SDR_FREQUENCY=162.550M
SDR_DEVICE_INDEX=0
SDR_SAMPLE_RATE=32000
SAME_SAMPLE_RATE=22050
SDR_GAIN=49.6
SDR_DEEMPHASIS=true
SDR_DC_BLOCK=true
SDR_FIR=true

# Comma-separated SAME/FIPS county codes. Leave empty to pass every decoded alert.
# Format: 0 + state FIPS + county FIPS. Example: Jefferson County, AL = 001073.
FIPS_FILTER=

AUDIO_STREAM_PORT=8765
LOG_LEVEL=INFO
LOG_FILE=/home/pi/logs/nwr/parser.log

# Space-separated topics for the optional MQTT audit service.
MQTT_AUDIT_TOPICS=nwr/#
